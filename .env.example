# Copy this file to .env for local use. On Streamlit Community Cloud, put the same
# names and values in the app's "Secrets" box instead (TOML format, see README).

# Groq LLM - writes the day-by-day plan. Without it the app builds an offline plan.
GROQ_API_KEY=your_groq_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Optional: real-time flights & hotels (Google Flights / Google Hotels) - https://serpapi.com
# Without it the app uses the sample data in data/.
SERPAPI_API_KEY=your_serpapi_key_here

# Optional: save trips to Supabase (Postgres) instead of local files.
# Use the project URL and the anon/publishable key; the table setup is in README.md.
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_TABLE=saved_trips

# Optional: per-session limit on trip plans, to protect the API quotas.
PLAN_LIMIT=5
PLAN_WINDOW_MINUTES=10

# Optional: most extra tool calls the agent may make for one plan or follow-up request
# (each flight or hotel search is one SerpApi search). 0 turns the agent's extra searches off.
AGENT_MAX_TOOL_CALLS=4

# Optional: DEBUG, INFO, WARNING or ERROR
LOG_LEVEL=INFO
